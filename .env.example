# Neon PostgreSQL — pooled connection string for the app + migrations.
# Dev branch goes here; production uses its own branch URL.
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/devstash?sslmode=require"

# Auth.js v5 (NextAuth)
# AUTH_SECRET: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""
# GitHub OAuth app credentials (Settings > Developer settings > OAuth Apps)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Resend email service
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"

# Email verification (default: true)
# Set to "false" to disable the email verification requirement.
# Useful in dev/staging when no custom Resend domain is configured.
EMAIL_VERIFICATION_ENABLED="true"
