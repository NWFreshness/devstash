# Neon PostgreSQL — pooled connection string for the app + migrations.
# Dev branch goes here; production uses its own branch URL.
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/devstash?sslmode=require"

# Auth.js v5 (NextAuth)
# AUTH_SECRET: generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=""
# GitHub OAuth app credentials (Settings > Developer settings > OAuth Apps)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Resend email service
RESEND_API_KEY=""
RESEND_FROM="onboarding@resend.dev"

# Upstash Redis — used for auth rate limiting.
# Leave blank to disable rate limiting (fail open).
# Get credentials at https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Email verification (default: true)
# Set to "false" to disable the email verification requirement.
# Useful in dev/staging when no custom Resend domain is configured.
EMAIL_VERIFICATION_ENABLED="true"

# BackBlaze B2 file storage (S3-compatible API)
# Key ID and application key from the B2 console.
# Endpoint: https://s3.REGION.backblazeb2.com (find REGION in your B2 bucket details)
B2_KEY_ID=""
B2_APPLICATION_KEY=""
B2_BUCKET_NAME=""
B2_REGION=""
B2_ENDPOINT=""

# Stripe billing
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
# Publishable key (used client-side in Phase 2)
STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret from the Stripe dashboard or `stripe listen`
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs for the Pro plan (create in Stripe dashboard > Products)
STRIPE_PRICE_ID_MONTHLY="price_..."
STRIPE_PRICE_ID_YEARLY="price_..."

# App URL — used for Stripe redirect URLs (checkout success/cancel)
NEXT_PUBLIC_APP_URL="http://localhost:3333"

# OpenAI API key for AI features
OPENAI_API_KEY=""